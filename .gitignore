# Fichiers et dossiers à ignorer

# Données
/saves/*
!/saves/.htaccess
/uploads/*
/logs/*

# Bibliothèques externes - INCLUSES dans git pour versions fixes
# Les bibliothèques doivent être commités pour garantir des versions stables
# /js/lib/*.mjs
# /js/lib/*.js

# Configuration locale
/php/config.local.php

# Système
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
/.vscode
/.idea
*.sublime-project
*.sublime-workspace

# Dépendances (si utilisation npm/composer future)
/node_modules
/vendor

# Fichiers temporaires
*.tmp
*.bak
*.log
