<IfModule mod_rewrite.c>

# Vérifier si l'adresse IP est dans le dossier "deny"
RewriteCond %{REMOTE_ADDR} ^(.*)
RewriteCond %{DOCUMENT_ROOT}/deny/%1.txt -f
RewriteRule ^ - [E=IP_DENY:1]

    # Exception pour le répertoire "checklist"
    RewriteCond %{REQUEST_URI} !^/checklist/

    # Exception pour la page process_data.php
    RewriteCond %{REQUEST_URI} !^/process_data.php


# Rediriger vers "/403.6" si l'adresse IP est bloquée
RewriteCond %{ENV:IP_DENY} 1
RewriteCond %{REQUEST_URI} !^/403.6
RewriteRule ^ /403.6 [L]

# Autoriser l'accès aux fichiers llm.txt et llm-full.txt (LLM crawlers)
RewriteRule ^llm\.txt$ - [L]
RewriteRule ^llm-full\.txt$ - [L]

# Supprime les points-virgules en fin d'URL
RewriteCond %{REQUEST_URI} ^(.+);$
RewriteRule ^ %1 [R=301,L]

# Bloquer les requêtes avec des mots clés suspects dans la chaîne de requête
 RewriteCond %{THE_REQUEST} cgi-bin [NC,OR]
 RewriteCond %{QUERY_STRING} ftp\: [NC,OR]
 RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
 RewriteCond %{QUERY_STRING} (<|%3C)([^s]*s)+cript.*(>|%3E) [NC,OR]
 RewriteCond %{QUERY_STRING} (\<|%3C).*iframe.*(\>|%3E) [NC,OR]
 RewriteCond %{QUERY_STRING} (<|%3C)([^i]*i)+frame.*(>|%3E) [NC,OR]
 RewriteCond %{QUERY_STRING} (NULL|OUTFILE|LOAD_FILE) [OR]

 RewriteCond %{QUERY_STRING} ^.*(union|select|cast|declare|drop|md5|benchmark|table|column|distinct|substr|concat|truncate|convert|exec|passthru|system|popen|load|between|null|delay|sleep|unhex|%00|%0A|%0D|%21|%22|%23|%24|%25|%27|%28|%29|%40|%60|%2A|%2B|%2C|%2D|%3B|%3C|%3E|%5B|%5C|%5D|%5E|%5F|%7B|%7C|%7D|%7E|>|<|sanitize|base64|@set|@ini|dirname|decode).* [NC,OR]
 RewriteCond %{QUERY_STRING} ^.*(sp_executesql).* [NC]
 RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
 RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})

# Blocks some XSS attacks
 RewriteCond %{QUERY_STRING} (\|%3E) [NC,OR]
 RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
 RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})

# PHP-CGI Vulnerability
  RewriteCond %{QUERY_STRING} ^(%2d|\-)[^=]+$ [NC,OR]

# Rediriger les requêtes bloquées vers une page d'erreur ou les rejeter avec un code 403
 RewriteRule ^ /429 [L]

</IfModule>

ErrorDocument 302 https://www.jourt.com/302
ErrorDocument 400 https://www.jourt.com/400
ErrorDocument 403 https://www.jourt.com/403
ErrorDocument 404 https://www.jourt.com/404
ErrorDocument 410 https://www.jourt.com/410
ErrorDocument 429 https://www.jourt.com/429
ErrorDocument 500 https://www.jourt.com/500
ErrorDocument 503 https://www.jourt.com/503
ErrorDocument 504 https://www.jourt.com/504

<filesMatch "">
Header set Cache-Control "store, cache, must-revalidate, max-age=36000, public"
Header set Content-Security-Policy "upgrade-insecure-requests; form-action 'self'; object-src 'none'; frame-ancestors 'self'; frame-src 'self'; child-src 'self'; default-src 'self'; manifest-src 'self'; script-src 'self' 'unsafe-inline' ; connect-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; base-uri 'self';"

</filesMatch>
<filesMatch ".(ico|jpg|jpeg|png|gif|webp|ico|woff2|css|js|json)$">
 Header set Cache-Control "max-age=31536000, public"
</filesMatch>
<filesMatch ".(txt|php)$">
 Header set Cache-Control "max-age=36000, public"
</filesMatch>


ExpiresActive On
ExpiresByType text/css "access 1 year"
ExpiresByType image/jpg "access 1 year"
ExpiresByType image/jpeg "access 1 year"
ExpiresByType image/gif "access 1 year"
ExpiresByType image/png "access 1 year"
ExpiresByType image/webp "access 1 year"
ExpiresByType image/x-icon "access 1 year"
ExpiresByType font/woff2  "access 1 year"
ExpiresByType application/font-woff2  "access 1 year"
ExpiresByType application/x-font-woff2  "access 1 year"
ExpiresByType text/txt "access plus 1 day"
ExpiresByType application/json "access plus 1 year"
#Header append Cache-Control "public"

RewriteEngine on
RewriteBase /

Options All -Indexes
Options -Indexes
Options +FollowSymlinks
IndexIgnore *

# Bloquer l'accès aux fichiers .txt dans le répertoire "deny"
RewriteCond %{REQUEST_URI} ^/deny/.+\.txt$
RewriteRule ^ - [F]
RewriteRule ^mail$  devis [L,NC,R=301]
RewriteRule ^rss.xml$  rss.php [L]
RewriteRule ^images/rss/([^/]+)/([^/]+)\.(\d+)\.webp$ images/rss/$1/$2.webp?date=$3 [L,NC]
RewriteRule ^images/wiki/([^/]+)\.(\d+)\.webp$ images/wiki/$1.webp?date=$2 [L,NC]

# Exception pour le répertoire "checklist"
RewriteCond %{REQUEST_URI} !^/checklist/
RewriteRule ^article-([^-]+)-([0-9]+).txt$ /article-$1-$2 [L]
RewriteRule ^article-([^-]+)-([0-9]+)/$ /article-$1-$2 [NC,R=301]
RewriteRule ^article-([^-]+)-([0-9]+)$ /blog.php?categorie=$1&article=$2 [L]
RewriteRule ^blog-([^-]+)-page([0-9]+)/$ /blog-$1-page$2 [NC,R=301]
RewriteRule ^blog-([^-]+)-page([0-9]+)$ /blog.php?categorie=$1&page=$2 [L]
RewriteRule ^blog-([^-]+)/$ /blog-$1 [NC,R=301]
RewriteRule ^blog-([^-]+)$ /blog.php?categorie=$1 [L]
RewriteRule ^sitemap.xml$  sitemap.php [NE,L]


RewriteRule ^return-policy$  return-policy.php [NE,L]
RewriteRule ^atelier-brest$  atelier-brest.php [NE,L]
RewriteRule ^emploi$  emploi.php [NE,L]
RewriteRule ^destockage$  destockage.php [NE,L]
RewriteRule ^devis$  devis.php [NE,L]
RewriteRule ^hall-of-fame$  hall-of-fame.php [NE,L]
RewriteRule ^information$  info.php [NE,L]
RewriteRule ^blog$  blog.php [QSA,NC,L]
RewriteRule ^cloud$  cloud.php [QSA,NC,L]

# Icones-entreprise - Redirection 301 trailing slash EN PREMIER
RewriteRule ^icones-entreprise/galerie-icones/$ /icones-entreprise/galerie-icones [R=301,L]
RewriteRule ^icones-entreprise/galerie-icones-page-([0-9]+)/$ /icones-entreprise/galerie-icones-page-$1 [R=301,L]
RewriteRule ^icones-entreprise/galerie-icones-image-([^/]+)-page-([0-9]+)/$ /icones-entreprise/galerie-icones-image-$1-page-$2 [R=301,NE,L]
RewriteRule ^icones-entreprise/galerie-icones-image-([^/]+)/$ /icones-entreprise/galerie-icones-image-$1 [R=301,NE,L]

RewriteRule ^400$ 400.php [NE,L]
RewriteRule ^403$ 403.php [NE,L]
RewriteRule ^403.6$ 403.6.php [NE,L]
RewriteRule ^404$ 404.php [NE,L]
RewriteRule ^410$ 410.php [NE,L]
RewriteRule ^429$ 429.php [NE,L]
RewriteRule ^500$ 500.php [NE,L]
RewriteRule ^503$ 503.php [NE,L]
RewriteRule ^504$ 504.php [NE,L]
RewriteRule ^ips$ ips.php [L]


#anti spammer
RewriteRule (?:^|/)wp-admin/(.*) 429 [L]
RewriteRule (?:^|/)wp-admin(.*) 429 [L]
RewriteRule (?:^|/)administrator/(.*) 429 [L]
RewriteRule (?:^|/)administrator(.*) 429 [L]
RewriteRule (?:^|/)wp-includes/(.*) 429 [L]
RewriteRule (?:^|/)wp-includes(.*) 429 [L]
RewriteRule (?:^|/)includes/(.*) 429 [L]
RewriteRule (?:^|/)includes(.*) 429 [L]
RewriteRule (?:^|/)core/(.*) 429 [L]
RewriteRule (?:^|/)core(.*) 429 [L]
RewriteRule (?:^|/)typo3/(.*) 429 [L]
RewriteRule (?:^|/)typo3(.*) 429 [L]
RewriteRule (?:^|/)wp-content/(.*) 429 [L]
RewriteRule (?:^|/)wp-content(.*) 429 [L]
RewriteRule (?:^|/)wp-login/(.*) 429 [L]
RewriteRule (?:^|/)wp-login(.*) 429 [L]
RewriteRule (?:^|/)wordpress/(.*) 429 [L]
RewriteRule (?:^|/)wordpress(.*) 429 [L]
RewriteRule (?:^|/)wp-json/(.*) 429 [L]
RewriteRule (?:^|/)wp-json(.*) 429 [L]
RewriteRule (?:^|/)wp/(.*) 429 [L]
RewriteRule (?:^|/)admin-ajax\.php 429 [L]
RewriteRule (?:^|/)wp-config\.php 429 [L]
RewriteRule (?:^|/)configuration\.php 429 [L]
RewriteRule (?:^|/)settings\.php 429 [L]
RewriteRule (?:^|/)default\.settings\.php 429 [L]
RewriteRule (?:^|/)LocalConfiguration\.php 429 [L]
RewriteRule (?:^|/)AdditionalConfiguration\.php 429 [L]

RewriteRule ^wp-login.php$ 429 [L]
RewriteRule ^wp-admin$ 429 [L]
RewriteRule ^administrator$ 429 [L]
RewriteRule ^admin.php$ 429 [L]
RewriteRule ^wp-config.php$ 429 [L]
RewriteRule ^phpMyAdmin/$ 429 [L]
RewriteRule ^mysqladmin/$ 429 [L]
RewriteRule ^myadmin/$ 429 [L]
RewriteRule ^database/$ 429 [L]
RewriteRule ^sql.php$ 429 [L]
RewriteRule ^phpinfo.php$ 429 [L]
RewriteRule ^shell.php$ 429 [L]
RewriteRule ^phpshell.php$ 429 [L]
RewriteRule ^phpmyadmin.php$ 429 [L]
RewriteRule ^adminer.php$ 429 [L]
RewriteRule ^pma/$ 429 [L]
RewriteRule ^cgi-bin/$ 429 [L]
RewriteRule ^config.php$ 429 [L]
RewriteRule ^backup/$ 429 [L]
RewriteRule ^upload/$ 429 [L]
RewriteRule ^wp-config.bak$ 429 [L]
