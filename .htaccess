RewriteRule ^wp-config.php~$ 429 [L]
RewriteRule ^\.htaccess$ 429 [L]
RewriteRule ^\.htpasswd$ 429 [L]
RewriteRule ^\.aahtpasswd$ 429 [L]
RewriteRule ^wp.php$ 429 [L]
RewriteRule ^upload.php$ 429 [L]
RewriteRule ^old-index.php$ 429 [L]
RewriteRule ^wikindex.php$ 429 [L]
RewriteRule ^install.php$ 429 [L]
